{
  "enabledMcpjsonServers": ["snowflake"],
  "permissions": {
    "allow": ["mcp__snowflake__run_snowflake_query"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate_tmdl.py\"",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
